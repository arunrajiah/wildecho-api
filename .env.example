# Copy to .env and edit. Every setting is optional; the defaults shown are what the
# service uses if you set nothing. .env is gitignored.

# --- Model ------------------------------------------------------------------
# Where the ONNX weights live. Fetch them with: python scripts/download_model.py
WILDECHO_MODEL_PATH=models/perch_v2.onnx
WILDECHO_TAXONOMY_PATH=data/taxonomy.csv
WILDECHO_MODEL_VERSION=perch_v2

# Per-taxonomic-group confidence adjustment (README "Confidence calibration").
# A missing file means no adjustment at all - identical to before this existed.
WILDECHO_CALIBRATION_PATH=data/calibration.yaml

# ONNX Runtime intra-op threads. 0 lets the runtime pick, which is best for a
# single request's latency. Set it to 1 or 2 when serving concurrent requests on
# a small instance instead - see README "Capacity planning".
WILDECHO_ONNX_INTRA_OP_THREADS=0

# --- Predictions ------------------------------------------------------------
# How many candidates to return.
WILDECHO_TOP_K=10

# Results whose top confidence is below this are flagged low_confidence. The 0.30
# default was calibrated against real recordings: a clean single-species clip
# scores about 0.63 to 0.73, white noise about 0.05, digital silence about 0.01.
# Raise it if you would rather show nothing than show a bad guess. This is the
# base threshold - data/calibration.yaml can shift it per taxonomic group.
WILDECHO_LOW_CONFIDENCE_THRESHOLD=0.3

# --- Upload limits (your main defence against resource exhaustion) ----------
WILDECHO_MAX_UPLOAD_BYTES=26214400
WILDECHO_MAX_DURATION_SECONDS=300
WILDECHO_MIN_DURATION_SECONDS=0.5
WILDECHO_SILENCE_RMS_THRESHOLD=0.0001

# --- Rate limiting ------------------------------------------------------------
# Per client IP, applies to /v1/identify and /v1/feedback. Tune this: 20/hour is a
# cautious public default, not a good one for your own phone. Accepts forms like
# "5/minute", "100/day".
WILDECHO_RATE_LIMIT=20/hour
WILDECHO_RATE_LIMIT_ENABLED=true

# --- HTTP -------------------------------------------------------------------
# Comma-separated origins, or * for any. Mobile apps need no CORS at all, so if
# you are not also serving a browser client, narrow this.
WILDECHO_CORS_ORIGINS=*
WILDECHO_LOG_LEVEL=INFO
# "text" for a readable local console, "json" for hosted log aggregators.
WILDECHO_LOG_FORMAT=text
# Response header carrying the per-request ID; reused if the client sends it in.
WILDECHO_REQUEST_ID_HEADER=X-Request-ID

# --- Feedback (opt-in accuracy corrections, README "Feedback") --------------
# Enables POST /v1/feedback. Set false to remove the endpoint entirely (404) if
# you don't want to collect corrections on this instance at all.
WILDECHO_FEEDBACK_ENABLED=true
# SQLite file, created on first use. Resolves relative to the working directory
# if left as a relative path - every deployment config here sets it explicitly.
WILDECHO_FEEDBACK_DB_PATH=data/feedback.sqlite3
# Save uploaded clips attached to feedback submissions. Set false to keep only
# the text correction and discard any uploaded audio after decoding.
WILDECHO_FEEDBACK_STORE_AUDIO=true
WILDECHO_FEEDBACK_CLIPS_DIR=data/feedback_clips
WILDECHO_FEEDBACK_MAX_UPLOAD_BYTES=26214400

# --- ffmpeg -----------------------------------------------------------------
WILDECHO_FFMPEG_PATH=ffmpeg
WILDECHO_FFPROBE_PATH=ffprobe
WILDECHO_FFMPEG_TIMEOUT_SECONDS=60

# --- docker compose only ----------------------------------------------------
WILDECHO_PORT=8000

# --- Hosted deployments only (Fly.io, Render; see fly.toml / render.yaml) ---
# Fetches the ~390 MiB weights automatically on first boot if missing, instead of
# requiring a manual `scripts/download_model.py` step on a host you don't have.
# Off by default so a plain `docker run` never starts a surprise download.
WILDECHO_AUTO_DOWNLOAD_MODEL=false
